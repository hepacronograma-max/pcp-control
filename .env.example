NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Obrigatório em produção para /api/cleanup (header x-cleanup-key no POST)
CLEANUP_SECRET=generate_a_long_random_secret

# Apenas desenvolvimento local (nunca na Vercel Production)
# PCP_LOCAL_DEV_EMAIL=admin@local
# PCP_LOCAL_DEV_PASSWORD=strong_local_only_password

# NÃO usar na Vercel Production:
# PCP_ALLOW_LOCAL_AUTH=1
# NEXT_PUBLIC_PCP_ALLOW_LOCAL_AUTH=1

# Prazo de entrega na importação - use UM dos dois:
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# DATABASE_URL=postgresql://postgres.[ref]:[password]@...

# Backup semanal (scripts/weekly-backup-supabase.js)
# PCP_BACKUP_DIR=C:\Users\SeuUsuario\OneDrive\Backups\PCP-Control
# PCP_BACKUP_KEEP_WEEKS=0
