NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Obrigatório em produção para /api/cleanup (header x-cleanup-key no POST)
CLEANUP_SECRET=

# GitHub (branch protection, scripts Fase 1)
GITHUB_ADMIN_TOKEN=ghp_xxx

# Apenas desenvolvimento local (nunca na Vercel Production)
# PCP_LOCAL_DEV_EMAIL=admin@local
# PCP_LOCAL_DEV_PASSWORD=strong_local_only_password

# NÃO usar na Vercel Production:
# PCP_ALLOW_LOCAL_AUTH=1
# NEXT_PUBLIC_PCP_ALLOW_LOCAL_AUTH=1

# Prazo de entrega na importação - use UM dos dois:
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# DATABASE_URL=postgresql://postgres.[ref]:[password]@...

# Backup semanal (scripts/weekly-backup-supabase.js)
# PCP_BACKUP_DIR=C:\Users\SeuUsuario\OneDrive\Backups\PCP-Control
# PCP_BACKUP_KEEP_WEEKS=0

# Backup diário (scripts/daily-backup-supabase.js)
# PCP_DAILY_BACKUP_DIR=C:\Users\SeuUsuario\Backups\PCP-Control\daily
# PCP_DAILY_BACKUP_KEEP_DAYS=30

# Telegram (notificações de backup)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# GitHub Release — repo PRIVADO separado (pcp-control-backups)
# GITHUB_BACKUP_TOKEN=ghp_...
# GITHUB_BACKUP_REPO=hepacronograma-max/pcp-control-backups
# BACKUP_ENCRYPTION_PASSWORD=
